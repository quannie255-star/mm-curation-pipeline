# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# 数据与产物（不入库；全量可由脚本重生成）
# 注意：gitignore 的 # 注释只能独占一行，行内注释会让模式失效
# ingest 去重 journal 等运行时状态
data/state/
data/annot/
# ⚠️ data/raw/ 下**除 .gitkeep 外全部是产物**（2026-09-27 实点：`git ls-files data/raw`
# 只列出 data/raw/.gitkeep）。data/raw/*/ 一条覆盖**所有**子目录——含点目录与深层嵌套
# （已在临时仓库实测；带尾斜杠只匹配目录，不匹配直挂文件）。
# 教训：旧写法逐条列举 images/html/real/text_cache/.cache，于是后来出现的
# fhir_synth/（44 KB）与 finance_news/（136 KB）不在名单里 → 未被忽略 →
# 任何人 git add -A 都会把它们暂存。**逐条列举的名单必然会被新目录追上。**
# 真实工业数据集原始下载 383 MB（GAP_AUDIT P0-1）也落在这条之下。
data/raw/*/
# 直挂在 data/raw/ 下的文件（不被 data/raw/*/ 匹配，必须单独列）
data/raw/*.jsonl
data/raw/manifest.json
data/interim/
data/processed/
# DuckDB 数仓（scripts/mmc.py build 的产物，一条命令可重建）
data/warehouse/
# 平台轨（S1–S6）生成物，重建命令：python -m mm_curation.cli run
# data/lake/ 是 Hive 分区的 Parquet 湖——实测 935 个分区文件 / 5.6 MB，
# 不挡会让每次全量重建产生近千条文件级 diff（比 2.4 MB 单行 diff 更难审）
data/lake/
# 非 dev 环境的产物根（prod 的湖/数仓/台账都在里面）——同样是可重建产物
data/envs/
# 观测快照（raw.json + prometheus.txt），由 obs 阶段写
runs/obs/
# 平台轨运行日志与批次统计（运行时产物，非源）
data/ops/
# FAISS 索引 + store（可重建产物）
data/indexes/
data/reports/
# 生成的可视化单页：内嵌 data/reports/ 的 JSON，一条命令可重生成 → 不入库
# （2.4 MB 且 JSON 在单行上，入库会让每次重建产生 2.4 MB 单行 diff）
# 重生成见 RUNBOOK §1.22；改版式改 scripts/templates/real_data_page.html
docs/real_data.html
site/
webdemo/data/
.cache/
# 本地转换的模型权重（CLIP ~750MB / GPT-2 zh ~500MB）
models/
*.faiss
*.bin
*.pt
*.onnx
*.safetensors

# Airflow
airflow.db
logs/
airflow-logs/

# IDE / OS
.idea/
.vscode/
.zcode/
.DS_Store
Thumbs.db

# 环境
.env

# uv 空壳锁（依赖声明在 requirements.txt / pyproject，未采用 uv 工作流）
uv.lock

# θ 阶段 oracle 模拟用户产物（seed 53/57 可复现，真人账另立 benchmark 名入库）
benchmarks/pref_user_v1/

# 助手记忆目录（不参与项目版本控制）
.workbuddy/

# pytest 临时目录（改用项目内 basetemp，避开系统 Temp 的批量删除护栏）
.pytest_tmp/

# dbt（数仓建模模块）生成物。**profiles.yml 不忽略**——
# 它只有相对路径、无凭据，入库才能让「clone 下来就跑得起来」
# （dbt 惯例是放~/.dbt/ 不入库，那是给有真凭据的场景用的）
warehouses/target/
warehouses/dbt_packages/
warehouses/logs/
warehouses/.user.yml
# ── 临时/ 生成物：绝不能入库 ──
# ⚠️ 本轮实点：、、、 全都**未被忽略**，
# 也就是说任何一次 （或将来某个脚本批量 add）都会把它们带进仓库。
# 根因是  被显式忽略了，但  下**别的**目录没被覆盖 ——
# 「忽略某个子目录」不等于「忽略整棵树」。
data/tmp/
data/tmp_*/
data/tmp_*.zip
# 黄金集（data/golden/）= **冻结评测资产，入库**（与 benchmarks/ 同地位）。
# ⚠️ 这条曾经是 `data/golden/` 整目录忽略 —— 与 data-ci.yml 的
#   「断言黄金集存在（缺则红，不许 fallback）」直接冲突：干净检出里没有基准，
#   检测 SLO 门禁**等于没有门禁**（2026-10-10 实测：本地全绿、Data CI 红）。
# 只放行门禁真正读的那两个文件（eval_detection_slo.py 读 jsonl + meta）；
# golden 下其余产物仍忽略。
data/golden/*
!data/golden/golden_set.jsonl
!data/golden/golden_meta.json
!data/golden/review_skeleton.json
# Studio 网页版（scripts/run_studio.py）把用户上传数据的清洗产物落在 data/studio/<名>/
# —— 与 data/processed/ 同性质的可重建运行时产物，绝不能入库
data/studio/
# 训练数据集制品（scripts/build_dataset.py 的产物）：Parquet shard + manifest。
# ⚠️ 与 data/reports/ 同类——**生成物**。入库会与「报告是生成物」的原则冲突：
#    gate-ci 有条断言「干净检出里 claim 层必须 0 PASS」，而 claims.json 有多条
#    指向 datasets/*/manifest.json；一旦入库，CI 上 claim 层不再空转 → 断言变红
#    （2026-10-10 实测栽过：本地全绿、推上去 gate-ci 红）。
# 重建：RUNBOOK（run_pipeline → build_dataset.py → verify_dataset_consumable.py）。
datasets/
# shell 重定向写错位置留下的空文件（本轮 heredoc 事故产物）
/=
.genie
.wbapp_*.genie
