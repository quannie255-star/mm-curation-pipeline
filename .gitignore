data/raw/images/
data/raw/*.jsonl
data/raw/manifest.json
data/raw/.cache/
data/raw/text_cache/
data/interim/
data/processed/
# FAISS 索引 + store（可重建产物）
data/indexes/
data/reports/
.cache/
# 本地转换的模型权重（CLIP ~750MB / GPT-2 zh ~500MB）
models/
*.faiss
*.bin
*.pt
*.onnx
*.safetensors

