# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# 数据与产物（不入库；全量可由脚本重生成）
# 注意：gitignore 的 # 注释只能独占一行，行内注释会让模式失效
# ingest 去重 journal 等运行时状态
data/state/
data/annot/
data/raw/images/
data/raw/*.jsonl
data/raw/manifest.json
data/raw/.cache/
data/raw/text_cache/
data/interim/
data/processed/
# FAISS 索引 + store（可重建产物）
data/indexes/
data/reports/
.cache/
# 本地转换的模型权重（CLIP ~750MB / GPT-2 zh ~500MB）
models/
*.faiss
*.bin
*.pt
*.onnx
*.safetensors

# Airflow
airflow.db
logs/
airflow-logs/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# 环境
.env

# uv 空壳锁（依赖声明在 requirements.txt / pyproject，未采用 uv 工作流）
uv.lock

# θ 阶段 oracle 模拟用户产物（seed 53/57 可复现，真人账另立 benchmark 名入库）
benchmarks/pref_user_v1/

# 助手记忆目录（不参与项目版本控制）
.workbuddy/
